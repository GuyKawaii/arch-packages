# Maintainer: Daniel
# Based on the AUR python-dlib recipe, CPU-only (no CUDA).

pkgname=python-dlib
_pkgname=dlib
# renovate: datasource=github-releases depName=davisking/dlib
pkgver=20.0.1
pkgrel=2
pkgdesc="Python bindings for dlib, a C++ machine learning toolkit (CPU-only)"
arch=('x86_64')
url="http://dlib.net/"
license=('BSL-1.0')
depends=(
	'cblas'
	'gcc-libs'
	'glibc'
	'lapack'
	'libx11'
	'python'
	'libgif.so'
	'libjpeg.so'
	'libjxl.so'
	'libjxl_threads.so'
	'libpng16.so'
	'libwebp.so'
)
makedepends=(
	'boost'
	'cmake'
	'python-build'
	'python-installer'
	'python-packaging'
	'python-setuptools'
	'python-wheel'
	'sqlite'
)
optdepends=('sqlite')
conflicts=('python-dlib-cuda')
source=("$_pkgname-$pkgver.tar.gz::https://github.com/davisking/dlib/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('dab5b4ec4b68bd7dc128a1fb7900723f89d2da107e44cd5def7d38fc57252a9d')

build() {
	cd "$_pkgname-$pkgver"
	# setup.py forwards DLIB_* env vars to CMake. pyproject.toml lists the
	# PyPI "cmake" package, which system cmake satisfies only in practice,
	# hence --skip-dependency-check.
	DLIB_USE_CUDA=OFF \
		python -m build --wheel --no-isolation --skip-dependency-check
}

package() {
	cd "$_pkgname-$pkgver"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
