# Line endings: LF in the repo and the working tree on every OS
* text=auto eol=lf

# Windows scripts keep CRLF so they still run
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never converted
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mhtml binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.m4a binary
*.mp3 binary
*.mp4 binary
*.wav binary
